# ---------------------------------------------------------------------------
# stop-order-scalp — machine-local settings
#
# Copy this file to `.env` and edit it. `.env` is git-ignored and must never be
# committed. It may hold credentials; config/default.yaml must never hold them.
#
# Precedence: real environment variables > .env > config/default.yaml
# ---------------------------------------------------------------------------

# --- execution mode -------------------------------------------------------
# DRY_RUN | PAPER | DEMO | LIVE
# DRY_RUN is the default and performs zero broker writes.
SOS_ENVIRONMENT=DRY_RUN

# LIVE requires BOTH of these to be true. There is no shortcut.
SOS_ALLOW_LIVE=false
# Separate opt-in per account-changing operation.
SOS_ALLOW_ORDER=false
SOS_ALLOW_CLOSE=false

# --- MetaTrader 5 terminal -------------------------------------------------
# Absolute path to terminal64.exe on THIS machine. Never hard-code this in
# application code; it lives here only.
SOS_MT5_PATH=
SOS_MT5_LOGIN=
SOS_MT5_PASSWORD=
SOS_MT5_SERVER=
SOS_MT5_TIMEOUT_MS=60000

# --- instrument / identity -------------------------------------------------
# Logical instrument stays US30. This is the broker's symbol name.
SOS_SYMBOL=US30
# Distinguishes this strategy's orders from anything else in the account.
SOS_MAGIC_NUMBER=20260930

# --- paths (relative to the project root unless absolute) ------------------
# SOS_CONFIG_PATH=config/default.yaml
# SOS_STATE_PATH=state/state.json
# SOS_LOG_DIR=logs
# SOS_ENV_FILE=.env

# --- optional integrations -------------------------------------------------
# Phase 8. Disabled unless explicitly enabled.
SOS_AL_BROOKS_ENABLED=false